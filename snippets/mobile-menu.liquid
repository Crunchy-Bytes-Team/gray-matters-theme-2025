{% assign mobile_collection_menu = linklists.collection %}
{% assign mobile_client_services_menu = linklists['top-client-services'] %}

<nav class='mobile-menu' aria-label='Mobile menu'>
  <div data-accordion-item>
    <button
      type='button'
      class='mobile-menu__navtext'
      data-accordion-button
      aria-controls='MobileMenuCollection'
      aria-expanded='false'
    >
      <span>Collection</span>
      <span class='mobile-menu__plus'>
        <span aria-hidden='true' data-accordion-plus>+</span>
        <span aria-hidden='true' class='hidden' data-accordion-minus>-</span>
      </span>
    </button>
    <div id='MobileMenuCollection' class='mobile-menu__panel hidden' data-accordion-panel>
      {% if mobile_collection_menu != blank and mobile_collection_menu.links != blank %}
        <ul class='mobile-menu__list'>
          {% for link in mobile_collection_menu.links %}
            <li>
              <a
                href='{{ link.url }}'
                class='mobile-menu__child mobile-menu__child--upper{% if link.url contains 'sale' %} is-active{% endif %}'
              >
                {{- link.title | escape -}}
              </a>
            </li>
          {% endfor %}
        </ul>
      {% else %}
        <ul class='mobile-menu__list'>
          <li>
            <a href='{{ routes.collections_url }}' class='mobile-menu__child'>Collection</a>
          </li>
        </ul>
      {% endif %}
    </div>
  </div>

  <div data-accordion-item>
    <button
      type='button'
      class='mobile-menu__navtext'
      data-accordion-button
      aria-controls='MobileMenuLanguage'
      aria-expanded='false'
    >
      <span>Language {{ localization.language.name | default: 'English' }}</span>
      <span class='mobile-menu__plus'>
        <span aria-hidden='true' data-accordion-plus>+</span>
        <span aria-hidden='true' class='hidden' data-accordion-minus>-</span>
      </span>
    </button>
    <div id='MobileMenuLanguage' class='mobile-menu__panel hidden' data-accordion-panel>
      {%- if localization.available_languages and localization.available_languages.size > 1 -%}
        <ul class='mobile-menu__list'>
          {%- for language in localization.available_languages -%}
            <li>
              {%- if language.iso_code == localization.language.iso_code -%}
                <span class='mobile-menu__child is-active'>
                  {{ language.endonym_name | default: language.name }}
                </span>
              {%- else -%}
                <a
                  href="{% render 'language-url-same-path', language: language %}"
                  hreflang='{{ language.iso_code }}'
                  class='mobile-menu__child'
                >
                  {{ language.endonym_name | default: language.name }}
                </a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- else -%}
        <p class='mobile-menu__child'>{{ 'localization.language_label' | t }}</p>
      {%- endif -%}
    </div>
  </div>

  <div data-accordion-item>
    <button
      type='button'
      class='mobile-menu__navtext'
      data-accordion-button
      aria-controls='MobileMenuClientService'
      aria-expanded='false'
    >
      <span>Client Services</span>
      <span class='mobile-menu__plus'>
        <span aria-hidden='true' data-accordion-plus>+</span>
        <span aria-hidden='true' class='hidden' data-accordion-minus>-</span>
      </span>
    </button>
    <div id='MobileMenuClientService' class='mobile-menu__panel hidden' data-accordion-panel>
      <a href='mailto:hello@graymattersnyc.com' class='mobile-menu__service'>
        {% render 'live-menu-icon', name: 'envelope' %}
        <span>Email</span>
      </a>
      <a href='tel:+19292950303' class='mobile-menu__service'>
        {% render 'live-menu-icon', name: 'phone' %}
        <span>+1 929 295 0303</span>
      </a>
      <span class='mobile-menu__hours'>Mon-Fri 10am-6pm EST</span>
      <div class='mobile-menu__rule'></div>
      {% if mobile_client_services_menu != blank and mobile_client_services_menu.links != blank %}
        {% for link in mobile_client_services_menu.links %}
          <a href='{{ link.url }}' class='mobile-menu__child'>
            {{- link.title | escape -}}
          </a>
        {% endfor %}
      {% endif %}
    </div>
  </div>

  <ul class='mobile-menu__utilities'>
    <li>
      <form
        action='{{ routes.search_url }}'
        method='get'
        role='search'
        class='mobile-menu__search'
      >
        <button
          type='submit'
          class='bg-transparent border-0 p-0'
          aria-label='{{ 'general.search.search' | t }}'
        >
          <svg class='mobile-menu__search-icon' viewBox='0 0 1792 1792' aria-hidden='true' focusable='false'>
            <path fill='currentColor' d='M1216 832q0-185-131.5-316.5t-316.5-131.5-316.5 131.5-131.5 316.5 131.5 316.5 316.5 131.5 316.5-131.5 131.5-316.5zm512 832q0 52-38 90t-90 38q-54 0-90-38l-343-342q-179 124-399 124-143 0-273.5-55.5t-225-150-150-225-55.5-273.5 55.5-273.5 150-225 225-150 273.5-55.5 273.5 55.5 225 150 150 225 55.5 273.5q0 220-124 399l343 343q37 37 37 90z'/>
          </svg>
        </button>
        <input
          class='mobile-menu__search-input'
          type='search'
          name='q'
          id='search_input1'
          placeholder='SEARCH'
          aria-label='{{ 'general.search.placeholder' | t }}'
        >
        <input type='hidden' name='options[prefix]' value='last'>
      </form>
    </li>
    <li>
      <a href='{{ routes.account_login_url }}' class='mobile-menu__utility'>
        {% render 'live-menu-icon', name: 'user' %}
        <span>Login / Create Account</span>
      </a>
    </li>
    <li>
      <a href='https://instagram.com/graymattersnyc' target='_blank' class='mobile-menu__utility'>
        {% render 'live-menu-icon', name: 'instagram' %}
        <span>@graymattersnyc</span>
      </a>
    </li>
  </ul>
</nav>

<script>
  (function () {
    var container = document.getElementById('MobileMenu');
    if (!container) return;
    var buttons = container.querySelectorAll('[data-accordion-button]');
    var panels = container.querySelectorAll('[data-accordion-panel]');
    var reduceMotionQuery =
      typeof window.matchMedia === 'function' ? window.matchMedia('(prefers-reduced-motion: reduce)') : null;
    var reduceMotion = reduceMotionQuery ? reduceMotionQuery.matches : false;

    if (!reduceMotion) {
      panels.forEach(function (panel) {
        panel.style.overflow = 'hidden';
        panel.style.maxHeight = '0px';
        panel.style.opacity = '0';
        panel.style.transition = 'max-height 250ms ease-out, opacity 250ms ease-out';
      });
    }

    function toggleIndicators(btn, expanded) {
      var iconWrap = btn.querySelector('[data-accordion-icon]');
      if (iconWrap) {
        var plusIcon = iconWrap.querySelector('[data-icon-plus]');
        var minusIcon = iconWrap.querySelector('[data-icon-minus]');
        if (plusIcon) plusIcon.classList.toggle('hidden', expanded);
        if (minusIcon) minusIcon.classList.toggle('hidden', !expanded);
      }
      var plusText = btn.querySelector('[data-accordion-plus]');
      var minusText = btn.querySelector('[data-accordion-minus]');
      if (plusText) plusText.classList.toggle('hidden', expanded);
      if (minusText) minusText.classList.toggle('hidden', !expanded);
    }

    function openPanel(btn, panel) {
      panel.classList.remove('hidden');
      btn.setAttribute('aria-expanded', 'true');
      toggleIndicators(btn, true);
      if (reduceMotion) return;

      if (panel._accordionCloseHandler) {
        panel.removeEventListener('transitionend', panel._accordionCloseHandler);
        panel._accordionCloseHandler = null;
      }
      if (panel._accordionOpenHandler) {
        panel.removeEventListener('transitionend', panel._accordionOpenHandler);
        panel._accordionOpenHandler = null;
      }

      panel.style.maxHeight = '0px';
      panel.style.opacity = '0';

      requestAnimationFrame(function () {
        panel.style.maxHeight = panel.scrollHeight + 'px';
        panel.style.opacity = '1';
      });

      panel._accordionOpenHandler = function (event) {
        if (event.target !== panel || event.propertyName !== 'max-height') return;
        panel.style.maxHeight = 'none';
        panel.removeEventListener('transitionend', panel._accordionOpenHandler);
        panel._accordionOpenHandler = null;
      };
      panel.addEventListener('transitionend', panel._accordionOpenHandler);
    }

    function closePanel(btn, panel) {
      btn.setAttribute('aria-expanded', 'false');
      toggleIndicators(btn, false);
      if (reduceMotion) {
        panel.classList.add('hidden');
        return;
      }

      if (panel._accordionOpenHandler) {
        panel.removeEventListener('transitionend', panel._accordionOpenHandler);
        panel._accordionOpenHandler = null;
      }
      if (panel._accordionCloseHandler) {
        panel.removeEventListener('transitionend', panel._accordionCloseHandler);
        panel._accordionCloseHandler = null;
      }

      panel.style.maxHeight = panel.scrollHeight + 'px';

      requestAnimationFrame(function () {
        panel.style.maxHeight = '0px';
        panel.style.opacity = '0';
      });

      panel._accordionCloseHandler = function (event) {
        if (event.target !== panel || event.propertyName !== 'max-height') return;
        panel.classList.add('hidden');
        panel.style.maxHeight = '0px';
        panel.removeEventListener('transitionend', panel._accordionCloseHandler);
        panel._accordionCloseHandler = null;
      };
      panel.addEventListener('transitionend', panel._accordionCloseHandler);
    }

    buttons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var panelId = btn.getAttribute('aria-controls');
        var panel = document.getElementById(panelId);
        if (!panel) return;
        var isHidden = panel.classList.contains('hidden');
        if (isHidden) {
          openPanel(btn, panel);
        } else {
          closePanel(btn, panel);
        }
      });
    });
  })();
</script>
