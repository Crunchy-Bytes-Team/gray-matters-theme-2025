{% assign video_mobile_enabled = product.metafields.module.video_module_enabled.value %}
{% assign video_mobile_url = product.metafields.module.video_module_video_mobile.value %}
{% assign module_image_val = product.metafields.module.image_text_module_image.value %}

{% if video_mobile_url != blank %}
  {% if video_mobile_enabled == 'true' %}
    <div class='w-full flex'>
      <div class='w-full lg:w-1/2'>
        <div class='relative w-full' style='padding-top: 177.78%;'>
          <iframe
            src='{{ video_mobile_url }}'
            class='absolute inset-0 w-full h-full'
            frameborder='0'
            allow='autoplay; fullscreen; picture-in-picture'
            allowfullscreen
            title='Vertical video'
            loading='lazy'
          ></iframe>
        </div>
      </div>
      <div class='lg:w-1/2 lg:flex flex-col items-center justify-center self-stretch'>
        <div>
          {% assign video_header = product.metafields.module.video_module_header.value | default: blank | strip %}
          {% assign video_description = product.metafields.module.video_module_description.value
            | default: blank
            | strip
          %}
          {% if video_header != blank %}
            <h3 class='font-accent text-xl lg:text-4xl text-center lg:text-left mb-2 lg:mb-3'>
              {{ video_header }}
            </h3>
          {% endif %}
          {% if video_description != blank %}
            <p class='font-accent text-sm lg:text-lg text-center lg:text-left mb-6 lg:mb-0'>
              {{ video_description }}
            </p>
          {% endif %}
        </div>
      </div>
    </div>
  {% endif %}
{% endif %}
