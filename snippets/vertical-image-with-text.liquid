{% assign module_image_val = product.metafields.module.image_text_module_image.value %}

{% if module_image_val and module_image_val != blank %}
  <div class='flex flex-col lg:flex-row items-stretch'>
    {%- comment -%}
      Old theme: text column is flex-centered; inner content ~280–300px wide,
      left-aligned (bandiera), so long titles like "ELEVATE WITH MYLA" wrap.
    {%- endcomment -%}
    <div class='w-full lg:w-1/2 flex flex-col items-center justify-center self-stretch px-6 lg:px-0'>
      <div class='w-full text-left max-w-[320px] margin-auto'>
        <h3 class='font-accent text-xl lg:text-[36px] leading-[1.3] tracking-[1px] text-left mb-[17.5px] uppercase'>
          {{ product.metafields.module.image_text_module_header.value }}
        </h3>
        <p class='font-accent text-sm lg:text-[18px] leading-snug tracking-[0.5px] text-left mb-6 lg:mb-0'>
          {{ product.metafields.module.image_text_module_description.value }}
        </p>
      </div>
    </div>
    <div class='w-full lg:w-1/2'>
      <img
        class='w-full block'
        src='{{ module_image_val }}'
        alt='{{ product.metafields.module.image_text_module_header.value | default: 'Image' | escape }}'
        width='800'
        height='600'
        loading='lazy'
      >
    </div>
  </div>
{% endif %}
