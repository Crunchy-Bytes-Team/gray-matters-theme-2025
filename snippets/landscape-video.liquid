{% assign video_src = video_src | default: product.metafields.module.video_module_video_landscape.value %}

{% if video_src != blank %}
  <div class='w-full aspect-video'>
    <iframe
      class='w-full h-full'
      src='{{ video_src }}'
      frameborder='0'
      allow='autoplay; fullscreen; picture-in-picture'
      allowfullscreen
      title='Landscape video'
      loading='lazy'
    ></iframe>
  </div>
{% endif %}
