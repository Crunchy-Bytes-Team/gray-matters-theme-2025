{% comment %}
  Pallini colore della scheda prodotto.

  Il prodotto aperto è sempre il primo pallino, senza link. Non dipende da
  module.product_variants: se quella lista non contiene la pagina corrente,
  il pallino c'è lo stesso.

  Gli altri pallini arrivano solo da module.product_variants. Una voce viene
  saltata quando:
  - il link è la pagina corrente
  - lo swatch è lo stesso del prodotto aperto (stessa immagine, altro url)
  - il prodotto è in bozza o non è pubblicato sull'Online Store

  Liquid non ha product.status. all_products non restituisce i draft: il drop
  è vuoto e published_at è blank. Con lo stesso segnale restano fuori anche
  i prodotti attivi ma non pubblicati sul canale Online Store.

  Gray Room / Archive Sale: solo il pallino del prodotto corrente.

  product_variants è JSON, in una di queste forme:
  {
    "entries": [{
      "handle": "egg-mules-bianco",
      "url": "https://www.graymattersnyc.com/products/egg-mules-bianco",
      "image": "https://cdn.shopify.com/...",
      "gid": "gid://shopify/Product/4418476769385"
    }]
  }
  Lo store ha sia .value.entries sia .entries. Vanno tenuti entrambi.
{% endcomment %}

{% liquid
  assign variants_metafield = product.metafields.module.product_variants
  assign variant_entries = blank
  assign color_vendor_norm = product.vendor | downcase | strip
  assign gray_room_current_only = false
  if color_vendor_norm == 'gray room'
    assign gray_room_current_only = true
  endif
%}

{% if variants_metafield != blank %}
  {% if variants_metafield.value != blank and variants_metafield.value.entries != blank %}
    {% assign variant_entries = variants_metafield.value.entries %}
  {% elsif variants_metafield.entries != blank %}
    {% assign variant_entries = variants_metafield.entries %}
  {% endif %}
{% endif %}

{% assign blank_color_hex = '#ff00bb' %}
{% assign default_color_hex = '#ffffff' %}

{% comment %}
  Immagine del prodotto aperto. Se la lista ha una voce che punta qui e ha
  uno swatch, si usa quello. Altrimenti module.product_color_img1.
  Quella voce non viene ristampata come link.
{% endcomment %}
{% assign current_color_image_url = '' %}
{% if variant_entries != blank %}
  {% for entry in variant_entries %}
    {% assign self_handle = entry.handle | default: blank %}
    {% if self_handle == blank and entry.url != blank %}
      {% assign self_handle = entry.url | split: '/products/' | last %}
      {% assign self_handle = self_handle | split: '?' | first | split: '#' | first | strip %}
    {% endif %}
    {% assign self_handle = self_handle | downcase %}
    {% if self_handle == product.handle and entry.image != blank %}
      {% assign current_color_image_url = entry.image %}
      {% break %}
    {% endif %}
  {% endfor %}
{% endif %}
{% if current_color_image_url == blank %}
  {% assign current_color_image_raw = product.metafields.module.product_color_img1.value %}
  {% if current_color_image_raw != blank %}
    {% if current_color_image_raw.url != blank %}
      {% assign current_color_image_url = current_color_image_raw.url %}
    {% else %}
      {% assign current_color_image_url = current_color_image_raw %}
    {% endif %}
  {% endif %}
{% endif %}

{% comment %}
  Colori di riserva del prodotto aperto. #ff00bb nel metafield significa
  "vuoto", non un colore da disegnare.
{% endcomment %}
{% assign raw_primary = product.metafields.custom.primary_color.value
  | default: product.metafields.custom.primary_color
  | default: ''
  | strip
%}
{% assign raw_secondary = product.metafields.custom.secondary_color.value
  | default: product.metafields.custom.secondary_color
  | default: ''
  | strip
%}
{% assign primary_hex = '' %}
{% assign secondary_hex = '' %}
{% assign blank_cmp = blank_color_hex | downcase %}
{% if raw_primary != blank %}
  {% assign raw_primary_lc = raw_primary | downcase %}
  {% if raw_primary_lc != blank_cmp %}
    {% assign primary_hex = raw_primary %}
  {% endif %}
{% endif %}
{% if raw_secondary != blank %}
  {% assign raw_secondary_lc = raw_secondary | downcase %}
  {% if raw_secondary_lc != blank_cmp %}
    {% assign secondary_hex = raw_secondary %}
  {% endif %}
{% endif %}

<div class='flex flex-nowrap w-max min-w-full'>
  <div
    class='color-variant-dot rounded-full overflow-hidden flex flex-col shrink-0 cursor-pointer mr-2'
    aria-current='true'
  >
    {% if current_color_image_url != blank %}
      <div
        class='w-full h-full bg-cover bg-center'
        style='background-image: url({{ current_color_image_url | escape }});'
      ></div>
    {% elsif primary_hex != blank and secondary_hex != blank %}
      <div class='w-full h-1/2' style='background-color: {{ primary_hex }};'></div>
      <div class='w-full h-1/2' style='background-color: {{ secondary_hex }};'></div>
    {% elsif primary_hex != blank %}
      <div class='w-full h-full' style='background-color: {{ primary_hex }};'></div>
    {% elsif secondary_hex != blank %}
      <div class='w-full h-full' style='background-color: {{ secondary_hex }};'></div>
    {% else %}
      <div class='w-full h-full' style='background-color: {{ default_color_hex }};'></div>
    {% endif %}
  </div>

  {% if variant_entries != blank and gray_room_current_only == false %}
    {% for entry in variant_entries %}
      {% assign variant_handle = entry.handle | default: blank %}
      {% if variant_handle == blank and entry.url != blank %}
        {% assign variant_handle = entry.url | split: '/products/' | last %}
        {% assign variant_handle = variant_handle | split: '?' | first | split: '#' | first | strip %}
      {% endif %}
      {% assign variant_handle = variant_handle | downcase %}
      {% if variant_handle == blank or variant_handle == product.handle %}
        {% continue %}
      {% endif %}

      {% comment %}
        Draft e non pubblicati sull'Online Store non sono in all_products.
        published_at vuoto copre entrambi: Liquid non distingue lo status.
      {% endcomment %}
      {% assign variant_product = all_products[variant_handle] %}
      {% if variant_product.published_at == blank %}
        {% continue %}
      {% endif %}

      {% assign variant_image_url = entry.image | default: blank %}
      {% if variant_image_url == blank %}
        {% assign variant_image_raw = variant_product.metafields.module.product_color_img1.value %}
        {% if variant_image_raw.url != blank %}
          {% assign variant_image_url = variant_image_raw.url %}
        {% else %}
          {% assign variant_image_url = variant_image_raw %}
        {% endif %}
      {% endif %}

      {% comment %} Stesso file del pallino corrente, appeso a un altro url. {% endcomment %}
      {% assign current_image_key = current_color_image_url | split: '?' | first | downcase | replace: 'https:', '' | replace: 'http:', '' %}
      {% assign variant_image_key = variant_image_url | split: '?' | first | downcase | replace: 'https:', '' | replace: 'http:', '' %}
      {% if current_image_key != blank and variant_image_key == current_image_key %}
        {% continue %}
      {% endif %}

      <a
        href='/products/{{ variant_handle }}'
        class='color-variant-dot rounded-full overflow-hidden flex flex-col shrink-0 mr-2'
        aria-label='{{ variant_handle | replace: "-", " " | escape }}'
      >
        {% if variant_image_url != blank %}
          <div
            class='w-full h-full bg-cover bg-center'
            style='background-image: url({{ variant_image_url | escape }});'
          ></div>
        {% else %}
          <div class='w-full h-full' style='background-color: {{ default_color_hex }};'></div>
        {% endif %}
      </a>
    {% endfor %}
  {% endif %}
</div>
