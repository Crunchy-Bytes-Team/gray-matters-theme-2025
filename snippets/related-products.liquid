{%- comment -%}
  Auto-suggested related products.
  Exclusions:
    - Current product
    - Draft/unpublished (published_at blank)
    - Color variants from module.product_variants
    - Vendor != "Gray Matters"
  Name = first word of the title.
  Color tokens (words in title, not hex metafields):
    1) If title contains " in " → words after " in " (e.g. "Myla Loafers in Vino")
    2) Else if secondary_color metafield is set (multi-color) → last 2 title words
       (e.g. "… Nero Rosso")
    3) Else → last title word
    Same color = candidate title contains ALL color tokens as whole words.
  Slots (distinct products; always target 4):
    1. same type + same color
    2. same type + different color
    3. same name + different color
    4. same type + same color + same name
    5. fallback: same collection, same color, different type
    Then pull extra matches from any criterion (and remaining
    Gray Matters candidates) until 4 products are filled.
{%- endcomment -%}

{%- assign vendor_norm = product.vendor | downcase | strip -%}
{%- if vendor_norm == 'gray matters' -%}

  {%- assign current_type = product.type | downcase | strip -%}
  {%- assign current_name = product.title | split: ' ' | first | downcase | strip -%}
  {%- assign title_down = product.title | downcase | strip -%}
  {%- assign blank_color = 'ff00bb' -%}
  {%- assign sep = '|' -%}
  {%- assign color_tokens = '' -%}

  {%- comment -%} Multi-color signal from secondary_color metafield (hex only used as flag) {%- endcomment -%}
  {%- assign sec_raw = product.metafields.custom.secondary_color.value
    | default: product.metafields.custom.secondary_color
    | default: ''
    | strip
    | downcase
    | remove: '#'
  -%}
  {%- assign is_multicolor = false -%}
  {%- if sec_raw != blank and sec_raw != blank_color -%}
    {%- assign is_multicolor = true -%}
  {%- endif -%}

  {%- if title_down contains ' in ' -%}
    {%- assign color_part = title_down | split: ' in ' | last | strip -%}
    {%- assign color_words = color_part | split: ' ' -%}
    {%- for w in color_words -%}
      {%- assign wl = w | strip -%}
      {%- if wl == blank or wl == current_name -%}{%- continue -%}{%- endif -%}
      {%- assign color_tokens = color_tokens | append: wl | append: sep -%}
    {%- endfor -%}
  {%- elsif is_multicolor -%}
    {%- assign rev_words = title_down | split: ' ' | reverse -%}
    {%- assign taken = 0 -%}
    {%- for w in rev_words -%}
      {%- if taken >= 2 -%}{%- break -%}{%- endif -%}
      {%- assign wl = w | strip -%}
      {%- if wl == blank or wl == current_name -%}{%- continue -%}{%- endif -%}
      {%- assign color_tokens = wl | append: sep | append: color_tokens -%}
      {%- assign taken = taken | plus: 1 -%}
    {%- endfor -%}
  {%- else -%}
    {%- assign wl = title_down | split: ' ' | last | strip -%}
    {%- if wl != blank and wl != current_name -%}
      {%- assign color_tokens = wl | append: sep -%}
    {%- endif -%}
  {%- endif -%}

  {%- assign color_variant_handles = '|' -%}
  {%- assign variants_metafield = product.metafields.module.product_variants -%}
  {%- assign variant_entries = blank -%}
  {%- if variants_metafield != blank -%}
    {%- if variants_metafield.value != blank and variants_metafield.value.entries != blank -%}
      {%- assign variant_entries = variants_metafield.value.entries -%}
    {%- elsif variants_metafield.entries != blank -%}
      {%- assign variant_entries = variants_metafield.entries -%}
    {%- else -%}
      {%- assign parsed_metafield = variants_metafield | parse_json -%}
      {%- if parsed_metafield != blank and parsed_metafield.entries != blank -%}
        {%- assign variant_entries = parsed_metafield.entries -%}
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}
  {%- if variant_entries != blank -%}
    {%- for entry in variant_entries -%}
      {%- if entry.url == blank -%}{%- continue -%}{%- endif -%}
      {%- assign cv_handle = entry.url | split: '/products/' | last -%}
      {%- assign cv_handle = cv_handle | split: '?' | first | split: '#' | first | strip -%}
      {%- if cv_handle == blank or cv_handle == product.handle -%}{%- continue -%}{%- endif -%}
      {%- assign cv_tok = sep | append: cv_handle | append: sep -%}
      {%- unless color_variant_handles contains cv_tok -%}
        {%- assign color_variant_handles = color_variant_handles | append: cv_handle | append: sep -%}
      {%- endunless -%}
    {%- endfor -%}
  {%- endif -%}

  {%- assign seen = '|' -%}
  {%- assign slot1_handles = '' -%}
  {%- assign slot2_handles = '' -%}
  {%- assign slot3_handles = '' -%}
  {%- assign slot4_handles = '' -%}
  {%- assign slot5_handles = '' -%}
  {%- assign vendor_only = '' -%}

  {%- for col in product.collections -%}
    {%- for cand in col.products -%}
      {%- assign tok = cand.handle | append: sep -%}
      {%- assign seen_tok = sep | append: tok -%}

      {%- if cand.id == product.id -%}{%- continue -%}{%- endif -%}
      {%- if seen contains seen_tok -%}{%- continue -%}{%- endif -%}
      {%- if color_variant_handles contains seen_tok -%}{%- continue -%}{%- endif -%}
      {%- if cand.published_at == blank -%}{%- continue -%}{%- endif -%}

      {%- assign cv = cand.vendor | downcase | strip -%}
      {%- if cv != 'gray matters' -%}{%- continue -%}{%- endif -%}

      {%- assign seen = seen | append: tok -%}
      {%- assign vendor_only = vendor_only | append: tok -%}

      {%- assign ct = cand.type | downcase | strip -%}
      {%- assign cn = cand.title | split: ' ' | first | downcase | strip -%}
      {%- assign cand_title_padded = ' ' | append: cand.title | downcase | append: ' ' -%}

      {%- assign same_type = false -%}
      {%- if current_type != '' and ct == current_type -%}{%- assign same_type = true -%}{%- endif -%}

      {%- assign same_name = false -%}
      {%- if current_name != '' and cn == current_name -%}{%- assign same_name = true -%}{%- endif -%}

      {%- assign same_color = false -%}
      {%- if color_tokens != blank -%}
        {%- assign same_color = true -%}
        {%- assign token_arr = color_tokens | split: sep -%}
        {%- for tw in token_arr -%}
          {%- if tw == blank -%}{%- continue -%}{%- endif -%}
          {%- assign needle = ' ' | append: tw | append: ' ' -%}
          {%- unless cand_title_padded contains needle -%}
            {%- assign same_color = false -%}
            {%- break -%}
          {%- endunless -%}
        {%- endfor -%}
      {%- endif -%}

      {%- if same_type and same_color and same_name -%}
        {%- assign slot4_handles = slot4_handles | append: tok -%}
      {%- endif -%}
      {%- if same_type and same_color -%}
        {%- assign slot1_handles = slot1_handles | append: tok -%}
      {%- endif -%}
      {%- if same_type and same_color == false -%}
        {%- assign slot2_handles = slot2_handles | append: tok -%}
      {%- endif -%}
      {%- if same_name and same_color == false -%}
        {%- assign slot3_handles = slot3_handles | append: tok -%}
      {%- endif -%}
      {%- if same_color and same_type == false -%}
        {%- assign slot5_handles = slot5_handles | append: tok -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endfor -%}

  {%- comment -%}
    Always fill up to 4 distinct products:
    1) one preferred pick per slot (4 → 1 → 2 → 3), backfill gaps with slot 5
    2) if still < 4, take extra matches from criteria pools (1→2→3→4→5)
    3) if still < 4, any remaining Gray Matters candidates from shared collections
  {%- endcomment -%}
  {%- assign target = 4 -%}
  {%- assign used = sep -%}
  {%- assign pick1 = '' -%}
  {%- assign pick2 = '' -%}
  {%- assign pick3 = '' -%}
  {%- assign pick4 = '' -%}

  {%- assign slot4_arr = slot4_handles | split: sep -%}
  {%- for h in slot4_arr -%}
    {%- if h == '' -%}{%- continue -%}{%- endif -%}
    {%- assign h_tok = sep | append: h | append: sep -%}
    {%- if used contains h_tok -%}{%- continue -%}{%- endif -%}
    {%- assign pick4 = h -%}
    {%- assign used = used | append: h | append: sep -%}
    {%- break -%}
  {%- endfor -%}

  {%- assign slot1_arr = slot1_handles | split: sep -%}
  {%- for h in slot1_arr -%}
    {%- if h == '' -%}{%- continue -%}{%- endif -%}
    {%- assign h_tok = sep | append: h | append: sep -%}
    {%- if used contains h_tok -%}{%- continue -%}{%- endif -%}
    {%- assign pick1 = h -%}
    {%- assign used = used | append: h | append: sep -%}
    {%- break -%}
  {%- endfor -%}

  {%- assign slot2_arr = slot2_handles | split: sep -%}
  {%- for h in slot2_arr -%}
    {%- if h == '' -%}{%- continue -%}{%- endif -%}
    {%- assign h_tok = sep | append: h | append: sep -%}
    {%- if used contains h_tok -%}{%- continue -%}{%- endif -%}
    {%- assign pick2 = h -%}
    {%- assign used = used | append: h | append: sep -%}
    {%- break -%}
  {%- endfor -%}

  {%- assign slot3_arr = slot3_handles | split: sep -%}
  {%- for h in slot3_arr -%}
    {%- if h == '' -%}{%- continue -%}{%- endif -%}
    {%- assign h_tok = sep | append: h | append: sep -%}
    {%- if used contains h_tok -%}{%- continue -%}{%- endif -%}
    {%- assign pick3 = h -%}
    {%- assign used = used | append: h | append: sep -%}
    {%- break -%}
  {%- endfor -%}

  {%- assign slot5_arr = slot5_handles | split: sep -%}
  {%- if pick1 == '' -%}
    {%- for h in slot5_arr -%}
      {%- if h == '' -%}{%- continue -%}{%- endif -%}
      {%- assign h_tok = sep | append: h | append: sep -%}
      {%- if used contains h_tok -%}{%- continue -%}{%- endif -%}
      {%- assign pick1 = h -%}
      {%- assign used = used | append: h | append: sep -%}
      {%- break -%}
    {%- endfor -%}
  {%- endif -%}
  {%- if pick2 == '' -%}
    {%- for h in slot5_arr -%}
      {%- if h == '' -%}{%- continue -%}{%- endif -%}
      {%- assign h_tok = sep | append: h | append: sep -%}
      {%- if used contains h_tok -%}{%- continue -%}{%- endif -%}
      {%- assign pick2 = h -%}
      {%- assign used = used | append: h | append: sep -%}
      {%- break -%}
    {%- endfor -%}
  {%- endif -%}
  {%- if pick3 == '' -%}
    {%- for h in slot5_arr -%}
      {%- if h == '' -%}{%- continue -%}{%- endif -%}
      {%- assign h_tok = sep | append: h | append: sep -%}
      {%- if used contains h_tok -%}{%- continue -%}{%- endif -%}
      {%- assign pick3 = h -%}
      {%- assign used = used | append: h | append: sep -%}
      {%- break -%}
    {%- endfor -%}
  {%- endif -%}
  {%- if pick4 == '' -%}
    {%- for h in slot5_arr -%}
      {%- if h == '' -%}{%- continue -%}{%- endif -%}
      {%- assign h_tok = sep | append: h | append: sep -%}
      {%- if used contains h_tok -%}{%- continue -%}{%- endif -%}
      {%- assign pick4 = h -%}
      {%- assign used = used | append: h | append: sep -%}
      {%- break -%}
    {%- endfor -%}
  {%- endif -%}

  {%- assign final = sep -%}
  {%- assign shown = 0 -%}
  {%- if pick1 != '' -%}
    {%- assign final = final | append: pick1 | append: sep -%}
    {%- assign shown = shown | plus: 1 -%}
  {%- endif -%}
  {%- if pick2 != '' -%}
    {%- assign final = final | append: pick2 | append: sep -%}
    {%- assign shown = shown | plus: 1 -%}
  {%- endif -%}
  {%- if pick3 != '' -%}
    {%- assign final = final | append: pick3 | append: sep -%}
    {%- assign shown = shown | plus: 1 -%}
  {%- endif -%}
  {%- if pick4 != '' -%}
    {%- assign final = final | append: pick4 | append: sep -%}
    {%- assign shown = shown | plus: 1 -%}
  {%- endif -%}

  {%- comment -%} Extra picks from criteria pools until we reach 4 {%- endcomment -%}
  {%- if shown < target -%}
    {%- assign fill_pools = slot1_handles
      | append: slot2_handles
      | append: slot3_handles
      | append: slot4_handles
      | append: slot5_handles
    -%}
    {%- assign fill_arr = fill_pools | split: sep -%}
    {%- for h in fill_arr -%}
      {%- if shown >= target -%}{%- break -%}{%- endif -%}
      {%- if h == '' -%}{%- continue -%}{%- endif -%}
      {%- assign h_tok = sep | append: h | append: sep -%}
      {%- if used contains h_tok -%}{%- continue -%}{%- endif -%}
      {%- assign final = final | append: h | append: sep -%}
      {%- assign used = used | append: h | append: sep -%}
      {%- assign shown = shown | plus: 1 -%}
    {%- endfor -%}
  {%- endif -%}

  {%- comment -%} Last resort: any remaining eligible Gray Matters products {%- endcomment -%}
  {%- if shown < target -%}
    {%- assign vendor_arr = vendor_only | split: sep -%}
    {%- for h in vendor_arr -%}
      {%- if shown >= target -%}{%- break -%}{%- endif -%}
      {%- if h == '' -%}{%- continue -%}{%- endif -%}
      {%- assign h_tok = sep | append: h | append: sep -%}
      {%- if used contains h_tok -%}{%- continue -%}{%- endif -%}
      {%- assign final = final | append: h | append: sep -%}
      {%- assign used = used | append: h | append: sep -%}
      {%- assign shown = shown | plus: 1 -%}
    {%- endfor -%}
  {%- endif -%}

  {%- if final != sep -%}
    <div class=''>
      <h3 class='w-full text-center font-accent font-normal text-xl uppercase mb-6'>You may also like</h3>
      <div class='relative w-full pb-6' data-relprod>
        <!-- Viewport -->
        <div class='overflow-hidden md:overflow-visible w-full' data-viewport>
          <!-- Track (flex on mobile, grid on md+) -->
          <div
            class='flex w-full transition-transform duration-300 ease-in-out md:grid md:grid-cols-4 md:gap-0'
            data-track
          >
            {%- assign final_arr = final | split: sep -%}
            {%- for h in final_arr -%}
              {%- if h == '' -%}{%- continue -%}{%- endif -%}
              {%- assign rp = all_products[h] -%}
              {%- if rp != blank and rp.published_at != blank -%}
                <div class='relative group basis-1/2 md:basis-auto shrink-0' data-item>
                  <a href='{{ rp.url }}'>
                    {% if rp.featured_image %}
                      <img
                        src='{{ rp.featured_image | image_url: width: 1200 }}'
                        alt='{{ rp.title | escape }}'
                        loading='lazy'
                      >
                    {% endif %}
                    <div
                      class='absolute inset-0 bg-black opacity-0 group-hover:opacity-30 transition-opacity duration-300 ease-in-out'
                    ></div>
                  </a>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>

        <!-- Controls (mobile only) -->
        <button
          type='button'
          class='md:hidden absolute left-2 top-1/2 -translate-y-1/2 flex items-center justify-center leading-none'
          aria-label='Previous'
          data-prev
        >
          <i class='fa-solid fa-chevron-left text-white drop-shadow' style='font-size:50px;'></i>
        </button>
        <button
          type='button'
          class='md:hidden absolute right-2 top-1/2 -translate-y-1/2 flex items-center justify-center leading-none'
          aria-label='Next'
          data-next
        >
          <i class='fa-solid fa-chevron-right  text-white drop-shadow' style='font-size:50px;'></i>
        </button>

        <!-- Progress bar -->
        <div
          class='absolute left-2 -bottom-3 h-[2px] w-[100px] bg-gray-300 opacity-0 transition-opacity duration-200'
          data-progress
        ></div>
      </div>
    </div>
  {%- endif -%}

{%- endif -%}
