{% if section.settings.message %}
  <style>

      @keyframes full-x-translate {
        from {
          transform:translateX(400%);
        }
        to {
          transform:translateX(-100%);
        }
      }

      .announsment_bar_top {
        {% if section.settings.slide_animation %}
          display: flex !important;
        {% endif %}
        background-color: {{ section.settings.color_bg }};
        color: {{ section.settings.color_text }};
      }

      .announsment_bar_top > span {
        transition: opacity 500ms ease-in-out;
      }

      .animate-translate-x {
        transform: translateX(400%);
        animation: full-x-translate 45s linear infinite;
      }


    @media only screen and (max-width: 767px) {
      @keyframes full-x-translate {
        from {
          transform:translateX(100%);
        }
        to {
          transform:translateX(-100%);
        }
      }

      .animate-translate-x {
        transform: translateX(100%);
        animation: full-x-translate 28s linear infinite;
      }
    }
  </style>

  {% comment %}
    ---------------------------------------------------------

     Show alternate messages in announcement bar if present

    ---------------------------------------------------------
  {% endcomment %}

  {% if section.settings.message_text_alt and section.settings.message_link_alt and section.settings.fade_animation %}
    <script>
      (function () {
        var messages = [
          { text: {{ section.settings.message_text_alt | json }}, link: {{ section.settings.message_link_alt | json }} },
          { text: {{ section.settings.message_text | json }}, link: {{ section.settings.message_link | json }} },
        ];

        function barNodes() {
          return {
            span: document.querySelector('.announsment_bar_top > span'),
            message: document.getElementById('announcement-bar-message'),
            link: document.getElementById('announcement-bar-link'),
          };
        }

        function show(msg) {
          var nodes = barNodes();
          if (nodes.span) nodes.span.style.opacity = '1';
          if (nodes.message) nodes.message.textContent = msg.text;
          if (nodes.link) nodes.link.setAttribute('href', msg.link);
        }

        function hide() {
          var nodes = barNodes();
          if (nodes.span) nodes.span.style.opacity = '0';
        }

        function cycle() {
          messages.forEach(function (msg, i) {
            setTimeout(function () { show(msg); }, 4000 * (i + 2));
            setTimeout(hide, 3500 * (i + 2));
          });
        }

        cycle();
        setInterval(cycle, 10000);
      })();
    </script>
  {% endif %}

  <a id='announcement-bar-link' href='{{ section.settings.message_link }}' class='announsment_bar_top'>
    <span
      id='announcement-bar-message'
      {% if section.settings.slide_animation %}
        class='animate-translate-x'
      {% endif %}
    >
      {{ section.settings.message_text | escape }}
    </span>
  </a>
{% endif %}
