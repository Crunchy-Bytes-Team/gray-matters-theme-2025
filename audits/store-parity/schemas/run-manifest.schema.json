{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graymattersnyc.com/schemas/store-parity/run-manifest.schema.json",
  "title": "Store parity run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "status",
    "created_at",
    "config_digest",
    "profile",
    "artifact_ids",
    "task_summary"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "INITIALIZING",
        "RUNNING",
        "FAILED",
        "COMPLETE"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "config_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "profile": {
      "enum": [
        "mobile-p0",
        "smoke",
        "full"
      ]
    },
    "artifact_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "uniqueItems": true
    },
    "task_summary": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "COMPLETE"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "completed_at"
        ],
        "properties": {
          "completed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  ]
}
