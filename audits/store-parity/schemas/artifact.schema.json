{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graymattersnyc.com/schemas/store-parity/artifact.schema.json",
  "title": "Store parity artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "run_id",
    "kind",
    "relative_path",
    "media_type",
    "size_bytes",
    "sha256",
    "created_at",
    "metadata"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "screenshot",
        "dom",
        "metadata",
        "diff",
        "report",
        "log",
        "other"
      ]
    },
    "relative_path": {
      "type": "string",
      "pattern": "^artifacts/(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "media_type": {
      "type": "string",
      "minLength": 1
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object"
    }
  }
}
