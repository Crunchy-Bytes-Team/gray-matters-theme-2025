{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graymattersnyc.com/schemas/store-parity/case-result.schema.json",
  "title": "Store parity case result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "page_id",
    "profile",
    "scenario",
    "viewport",
    "status",
    "started_at",
    "artifact_ids",
    "metrics"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "page_id": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "enum": [
        "mobile-p0",
        "smoke",
        "full"
      ]
    },
    "scenario": {
      "type": "string",
      "minLength": 1
    },
    "feature": {
      "type": "string",
      "minLength": 1
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "status": {
      "enum": [
        "PENDING",
        "RUNNING",
        "PASSED",
        "FAILED",
        "ERROR",
        "SKIPPED"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "artifact_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "uniqueItems": true
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
